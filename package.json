{
  "name": "zeal-user-contrib",
  "version": "2.0.0",
  "description": "A convenient CLI to add Dash's User Contributed docsets to Zeal",
  "repository": "jmerle/zeal-user-contrib",
  "homepage": "https://github.com/jmerle/zeal-user-contrib",
  "bugs": "https://github.com/jmerle/zeal-user-contrib/issues",
  "author": "Jasper van Merle",
  "license": "MIT",
  "exports": "./lib/index.mjs",
  "types": "lib/index.d.mts",
  "bin": "./bin/run",
  "keywords": [
    "zeal",
    "dash",
    "docset",
    "docsets",
    "cli"
  ],
  "files": [
    "/bin",
    "/lib"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc",
    "start": "pnpm build && ./bin/run",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:eslint": "eslint --format codeframe 'src/**'",
    "lint:prettier": "prettier --check --ignore-path .gitignore '**/*.{yml,json}'",
    "fix": "pnpm run --sequential \"/^fix:.*/\"",
    "fix:eslint": "pnpm lint:eslint --fix",
    "fix:prettier": "prettier --write --ignore-path .gitignore '**/*.{yml,json}'",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "es-toolkit": "^1.45.1",
    "fs-extra": "^11.3.4",
    "got": "^13.0.0",
    "ini": "^6.0.0",
    "inquirer": "^9.3.8",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "progress": "^2.0.3",
    "table": "^6.9.0",
    "tar": "^7.5.11",
    "tempy": "^3.2.0",
    "tslib": "^2.8.1",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/ini": "^4.1.1",
    "@types/inquirer": "^9.0.9",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/node": "^24.12.0",
    "@types/progress": "^2.0.7",
    "@types/winreg": "^1.2.36",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-codeframe": "^7.32.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=24"
  },
  "np": {
    "tests": false
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
